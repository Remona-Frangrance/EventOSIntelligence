# ==============================================================================
# EventOS Intelligence - Environment Configuration
# ==============================================================================

# 1. DATABASE CONFIGURATION (Supabase / PostgreSQL)
# Direct connection pooler string for Supabase PostgreSQL.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# 2. APPLICATION ENVIRONMENT
# Set to 'production' for live deployments. When 'production', in-memory fallback is disabled.
NODE_ENV="development"
# Base URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# 3. SECURITY & AUTHENTICATION SECRETS
# Minimum 32-character random string used to sign HTTP-only session JWT cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET="eventos-super-secret-session-key-2026-production-ready-min32"

# 4. CERTIFICATE CRYPTOGRAPHIC PROOF
# Secret key used for HMAC-SHA256 tamper-proof credential signatures.
# Generate with: openssl rand -base64 32
CERTIFICATE_SECRET="eventos-cert-secret-2026-tamper-proof-hmac-key"

# 5. EMAIL / SMTP NOTIFICATIONS (Nodemailer)
# Optional SMTP configuration for login alerts, pass deliveries, and certificates.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@eventos.local"
SMTP_PASS="your-app-password"
SMTP_FROM="EventOS Intelligence <notifications@eventos.local>"

# 6. ANTHROPIC AI ENGINE (Optional - automatically falls back to deterministic engine when unset)
# Used for post-event executive summaries, intelligent feedback clustering, and visitor floor guide.
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# 7. CLOUDINARY PUBLIC CLOUD MEDIA STORAGE (Images & Videos)
# Free instant global CDN hosting and video transcoding. Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

